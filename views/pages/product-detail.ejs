<div id="app" data-product-id="<%= productId %>">

  <div v-if="loading" class="flex justify-center py-20 px-20">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="notFound" class="text-center py-20">
    <p class="text-[48px] mb-4" style="font-family: 'Cormorant Garamond', serif;">🌿</p>
    <h2 class="text-xl text-text-primary mb-2">找不到此商品</h2>
    <a href="/" class="text-rose-primary hover:text-rose-dark text-sm transition-colors">回到首頁</a>
  </div>

  <template v-else-if="product">
    <!-- Breadcrumb -->
    <div class="hidden md:flex items-center gap-2 px-4 md:px-12 lg:px-20 py-4 text-[12px]">
      <a href="/" class="text-text-muted hover:text-text-secondary transition-colors">首頁</a>
      <span class="text-forest-border">/</span>
      <a href="/#products" class="text-text-muted hover:text-text-secondary transition-colors">商品</a>
      <span class="text-forest-border">/</span>
      <span class="text-text-primary">{{ product.name }}</span>
    </div>

    <!-- Product Detail -->
    <div class="flex flex-col md:flex-row gap-8 lg:gap-20 px-4 md:px-12 lg:px-20 pb-12 lg:pb-16 pt-4 lg:pt-4">
      <!-- Left: Image -->
      <div class="flex flex-col gap-3 flex-1 min-w-0">
        <div class="rounded-2xl lg:rounded-3xl overflow-hidden" style="height: clamp(260px, 70vw, 480px);">
          <img
            :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=600'"
            :alt="product.name"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Right: Info -->
      <div class="flex flex-col gap-6 flex-1 min-w-0">
        <p class="text-rose-primary text-[11px] tracking-[0.2em] uppercase">春季精選</p>
        <h1 class="text-[52px] font-normal italic leading-[1.1] text-text-primary" style="font-family: 'Cormorant Garamond', serif;">
          {{ product.name }}
        </h1>
        <p class="text-[36px] font-semibold text-apricot leading-none" style="font-family: 'Cormorant Garamond', serif;">
          NT$ {{ product.price.toLocaleString() }}
        </p>

        <div class="flex items-center gap-2 text-[13px]">
          <span class="text-sage">✓</span>
          <span class="text-text-secondary">尚有 {{ product.stock }} 件</span>
        </div>

        <p class="text-text-secondary text-[14px] leading-[1.8]">{{ product.description }}</p>

        <div class="h-px bg-forest-border"></div>

        <!-- Quantity Selector -->
        <div class="flex items-center gap-5">
          <span class="text-[13px] text-text-secondary">數量</span>
          <div class="flex items-center border border-forest-border rounded-full overflow-hidden">
            <button
              @click="decrease"
              class="w-10 h-10 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-forest-mid transition-colors"
            >−</button>
            <span class="w-12 h-10 flex items-center justify-center text-[14px] text-text-primary border-x border-forest-border">
              {{ quantity }}
            </span>
            <button
              @click="increase"
              class="w-10 h-10 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-forest-mid transition-colors"
            >+</button>
          </div>
        </div>

        <!-- Add to Cart -->
        <button
          @click="addToCart"
          :disabled="adding || product.stock <= 0"
          class="w-full bg-rose-primary text-text-primary py-4 rounded-full text-[15px] font-medium hover:bg-rose-dark transition-colors disabled:opacity-40 flex items-center justify-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
        </button>

        <!-- Purchase Notes -->
        <div class="bg-forest-mid rounded-2xl p-5 flex flex-col gap-2">
          <h3 class="text-text-secondary text-[13px] font-medium mb-1">購買須知</h3>
          <p class="text-text-muted text-[12px]">• 花材依據季節供應，實際花束可能略有差異</p>
          <p class="text-text-muted text-[12px]">• 台北市區可享當日配送服務</p>
          <p class="text-text-muted text-[12px]">• 消費滿 NT$ 500 享免運優惠</p>
        </div>
      </div>
    </div>
  </template>

</div>
