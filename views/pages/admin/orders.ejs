<div id="app">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-[28px] font-normal text-text-primary" style="font-family: 'Cormorant Garamond', serif;">訂單管理</h1>
    <div class="flex items-center gap-3">
      <label class="text-[13px] text-text-secondary">狀態篩選</label>
      <select
        v-model="statusFilter"
        class="bg-forest-mid border border-forest-border rounded-xl px-3 py-2 text-[13px] text-text-primary focus:outline-none focus:border-rose-primary transition-colors"
      >
        <option value="">全部</option>
        <option value="pending">待付款</option>
        <option value="paid">已付款</option>
        <option value="failed">付款失敗</option>
      </select>
    </div>
  </div>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <template v-else>
    <div class="bg-forest-mid rounded-2xl overflow-hidden border border-forest-border">
      <table class="w-full text-[13px]">
        <thead>
          <tr class="border-b border-forest-border text-text-muted">
            <th class="text-left px-5 py-4 font-normal">訂單編號</th>
            <th class="text-left px-5 py-4 font-normal">買家</th>
            <th class="text-right px-5 py-4 font-normal">金額</th>
            <th class="text-center px-5 py-4 font-normal">狀態</th>
            <th class="text-right px-5 py-4 font-normal">日期</th>
          </tr>
        </thead>
        <tbody>
          <tr
            v-for="order in orders"
            :key="order.id"
            class="border-t border-forest-border hover:bg-forest-dark cursor-pointer transition-colors"
            @click="viewDetail(order.id)"
          >
            <td class="px-5 py-4 text-text-primary font-medium">{{ order.order_no }}</td>
            <td class="px-5 py-4 text-text-secondary">{{ order.recipient_name }}</td>
            <td class="px-5 py-4 text-right text-apricot" style="font-family: 'Cormorant Garamond', serif;">NT$ {{ order.total_amount.toLocaleString() }}</td>
            <td class="px-5 py-4 text-center">
              <span
                class="text-[11px] px-3 py-1 rounded-full border"
                :class="statusMap[order.status]?.cls || 'bg-forest-dark text-text-muted border-forest-border'"
              >
                {{ statusMap[order.status]?.label || order.status }}
              </span>
            </td>
            <td class="px-5 py-4 text-right text-text-muted">
              {{ new Date(order.created_at).toLocaleDateString('zh-TW') }}
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div v-if="pagination.totalPages > 1" class="flex justify-center gap-2 mt-6">
      <button
        v-for="p in pagination.totalPages"
        :key="p"
        @click="loadOrders(p)"
        class="w-10 h-10 rounded-full text-[13px] transition-colors"
        :class="p === pagination.page ? 'bg-rose-primary text-text-primary' : 'bg-forest-mid text-text-secondary hover:bg-forest-border'"
      >
        {{ p }}
      </button>
    </div>
  </template>

  <!-- Order Detail Modal -->
  <div v-if="detailVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/60" @click="detailVisible = false"></div>
    <div class="relative bg-forest-mid rounded-2xl border border-forest-border w-full max-w-2xl mx-4 p-6 max-h-[80vh] overflow-y-auto">
      <div v-if="detailLoading" class="flex justify-center py-8">
        <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
      </div>
      <template v-else-if="detailOrder">
        <div class="flex items-start justify-between mb-5">
          <h3 class="text-[24px] font-normal text-text-primary" style="font-family: 'Cormorant Garamond', serif;">訂單詳情</h3>
          <button @click="detailVisible = false" class="text-text-muted hover:text-text-primary text-xl transition-colors">&times;</button>
        </div>

        <div class="flex flex-col gap-5 text-[13px]">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-text-muted mb-1">訂單編號</p>
              <p class="text-text-primary">{{ detailOrder.order_no }}</p>
            </div>
            <div>
              <p class="text-text-muted mb-1">狀態</p>
              <span
                class="text-[11px] px-3 py-1 rounded-full border"
                :class="statusMap[detailOrder.status]?.cls || 'bg-forest-dark text-text-muted border-forest-border'"
              >
                {{ statusMap[detailOrder.status]?.label || detailOrder.status }}
              </span>
            </div>
            <div>
              <p class="text-text-muted mb-1">買家</p>
              <p class="text-text-primary">{{ detailOrder.user?.name }} ({{ detailOrder.user?.email }})</p>
            </div>
            <div>
              <p class="text-text-muted mb-1">日期</p>
              <p class="text-text-primary">{{ new Date(detailOrder.created_at).toLocaleDateString('zh-TW') }}</p>
            </div>
          </div>

          <div class="border-t border-forest-border pt-4">
            <p class="text-text-muted mb-3">收件資訊</p>
            <p class="text-text-primary">{{ detailOrder.recipient_name }}</p>
            <p class="text-text-secondary">{{ detailOrder.recipient_email }}</p>
            <p class="text-text-secondary">{{ detailOrder.recipient_address }}</p>
          </div>

          <div class="border-t border-forest-border pt-4">
            <p class="text-text-muted mb-3">商品明細</p>
            <table class="w-full">
              <thead>
                <tr class="text-text-muted border-b border-forest-border">
                  <th class="text-left py-2 font-normal">商品名稱</th>
                  <th class="text-right py-2 font-normal">單價</th>
                  <th class="text-right py-2 font-normal">數量</th>
                  <th class="text-right py-2 font-normal">小計</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="item in detailOrder.items" :key="item.id" class="border-b border-forest-border">
                  <td class="py-3 text-text-primary">{{ item.product_name }}</td>
                  <td class="py-3 text-right text-text-secondary">NT$ {{ item.product_price.toLocaleString() }}</td>
                  <td class="py-3 text-right text-text-secondary">{{ item.quantity }}</td>
                  <td class="py-3 text-right text-text-primary">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</td>
                </tr>
              </tbody>
            </table>
            <div class="flex justify-end mt-4 pt-3 border-t border-forest-border">
              <span class="text-apricot text-[20px]" style="font-family: 'Cormorant Garamond', serif;">
                總計 NT$ {{ detailOrder.total_amount.toLocaleString() }}
              </span>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>
