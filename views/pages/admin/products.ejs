<div id="app">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-[28px] font-normal text-text-primary" style="font-family: 'Cormorant Garamond', serif;">商品管理</h1>
    <button
      @click="openCreate"
      class="bg-rose-primary text-text-primary px-5 py-2.5 rounded-full text-[13px] hover:bg-rose-dark transition-colors"
    >
      + 新增商品
    </button>
  </div>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <template v-else>
    <div class="bg-forest-mid rounded-2xl overflow-hidden border border-forest-border">
      <table class="w-full text-[13px]">
        <thead>
          <tr class="border-b border-forest-border text-text-muted">
            <th class="text-left px-5 py-4 font-normal">圖片</th>
            <th class="text-left px-5 py-4 font-normal">商品名稱</th>
            <th class="text-right px-5 py-4 font-normal">價格</th>
            <th class="text-right px-5 py-4 font-normal">庫存</th>
            <th class="text-right px-5 py-4 font-normal">操作</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="product in products" :key="product.id" class="border-t border-forest-border hover:bg-forest-dark transition-colors">
            <td class="px-5 py-4">
              <img
                :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=100'"
                :alt="product.name"
                class="w-12 h-12 rounded-xl object-cover"
              />
            </td>
            <td class="px-5 py-4 text-text-primary">{{ product.name }}</td>
            <td class="px-5 py-4 text-right text-apricot" style="font-family: 'Cormorant Garamond', serif;">NT$ {{ product.price.toLocaleString() }}</td>
            <td class="px-5 py-4 text-right text-text-secondary">{{ product.stock }}</td>
            <td class="px-5 py-4 text-right">
              <button
                @click="openEdit(product)"
                class="text-[12px] text-sage border border-sage/40 rounded-lg px-3 py-1.5 mr-2 hover:bg-sage/10 transition-colors"
              >
                編輯
              </button>
              <button
                @click="confirmDeleteFn(product.id)"
                class="text-[12px] text-rose-primary border border-rose-primary/40 rounded-lg px-3 py-1.5 hover:bg-rose-primary/10 transition-colors"
              >
                刪除
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div v-if="pagination.totalPages > 1" class="flex justify-center gap-2 mt-6">
      <button
        v-for="p in pagination.totalPages"
        :key="p"
        @click="loadProducts(p)"
        class="w-10 h-10 rounded-full text-[13px] transition-colors"
        :class="p === pagination.page ? 'bg-rose-primary text-text-primary' : 'bg-forest-mid text-text-secondary hover:bg-forest-border'"
      >
        {{ p }}
      </button>
    </div>
  </template>

  <!-- Product Modal -->
  <div v-if="modalVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/60" @click="modalVisible = false"></div>
    <div class="relative bg-forest-mid rounded-2xl border border-forest-border w-full max-w-lg mx-4 p-6">
      <h3 class="text-[22px] font-normal text-text-primary mb-5" style="font-family: 'Cormorant Garamond', serif;">
        {{ editingProduct ? '編輯商品' : '新增商品' }}
      </h3>
      <form @submit.prevent="handleSave" class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <label class="text-text-secondary text-[13px]">商品名稱 *</label>
          <input v-model="form.name" type="text" class="w-full bg-forest-dark border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary focus:outline-none focus:border-rose-primary transition-colors" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-text-secondary text-[13px]">商品描述</label>
          <textarea v-model="form.description" rows="3" class="w-full bg-forest-dark border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary resize-none focus:outline-none focus:border-rose-primary transition-colors"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-2">
            <label class="text-text-secondary text-[13px]">價格 *</label>
            <input v-model.number="form.price" type="number" min="1" class="w-full bg-forest-dark border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary focus:outline-none focus:border-rose-primary transition-colors" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-text-secondary text-[13px]">庫存 *</label>
            <input v-model.number="form.stock" type="number" min="0" class="w-full bg-forest-dark border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary focus:outline-none focus:border-rose-primary transition-colors" />
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-text-secondary text-[13px]">圖片 URL</label>
          <input v-model="form.image_url" type="text" class="w-full bg-forest-dark border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary focus:outline-none focus:border-rose-primary transition-colors" />
        </div>
        <div class="flex justify-end gap-3 pt-2">
          <button type="button" @click="modalVisible = false" class="px-5 py-2.5 text-[13px] rounded-full border border-forest-border text-text-secondary hover:border-text-muted transition-colors">取消</button>
          <button type="submit" :disabled="saving" class="px-5 py-2.5 text-[13px] rounded-full bg-rose-primary text-text-primary hover:bg-rose-dark disabled:opacity-40 transition-colors">
            {{ saving ? '儲存中...' : '儲存' }}
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Confirm Delete Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/60" @click="confirmVisible = false"></div>
    <div class="relative bg-forest-mid rounded-2xl border border-forest-border w-full max-w-sm mx-4 p-6 text-center">
      <h3 class="text-[22px] font-normal text-text-primary mb-2" style="font-family: 'Cormorant Garamond', serif;">確認刪除</h3>
      <p class="text-text-secondary text-[13px] mb-6">確定要刪除這個商品嗎？此操作無法復原。</p>
      <div class="flex gap-3 justify-center">
        <button @click="confirmVisible = false" class="px-5 py-2.5 text-[13px] rounded-full border border-forest-border text-text-secondary hover:border-text-muted transition-colors">取消</button>
        <button @click="handleDelete" class="px-5 py-2.5 text-[13px] rounded-full bg-rose-primary text-text-primary hover:bg-rose-dark transition-colors">確認刪除</button>
      </div>
    </div>
  </div>
</div>
