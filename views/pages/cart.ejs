<div id="app">

  <!-- Title Row -->
  <div class="flex items-baseline justify-between px-4 md:px-12 lg:px-20 pt-8 lg:pt-10 pb-0">
    <div class="flex items-baseline gap-3">
      <h1 class="text-[48px] font-normal italic text-text-primary" style="font-family: 'Cormorant Garamond', serif;">購物車</h1>
      <span v-if="items.length > 0" class="text-text-secondary text-[14px]">{{ items.length }} 件商品</span>
    </div>
    <a href="/" class="text-text-muted text-[13px] hover:text-text-secondary transition-colors">← 繼續購物</a>
  </div>

  <!-- Free Shipping Banner -->
  <div v-if="items.length > 0" class="mx-4 md:mx-12 lg:mx-20 mt-4">
    <div v-if="total < Shipping.FREE_SHIPPING_THRESHOLD" class="flex items-center justify-center gap-2 bg-forest-mid py-3 rounded-xl text-[13px] text-rose-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      再買 NT$ {{ (Shipping.FREE_SHIPPING_THRESHOLD - total).toLocaleString() }} 即可免宅配基本運費！
    </div>
    <div v-else class="flex items-center justify-center gap-2 bg-forest-mid py-3 rounded-xl text-[13px] text-sage">
      <span>✓</span> 已達免運門檻！
    </div>
  </div>

  <div v-if="loading" class="flex justify-center py-12 px-20">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="items.length === 0" class="text-center px-20 py-20">
    <p class="text-[64px] mb-4" style="font-family: 'Cormorant Garamond', serif; color: var(--color-forest-border);">∅</p>
    <p class="text-text-secondary mb-2">購物車是空的</p>
    <p class="text-text-muted text-[13px] mb-6">快去挑選喜歡的花束吧！</p>
    <a href="/" class="inline-block bg-rose-primary text-text-primary px-8 py-3 rounded-full text-[13px] hover:bg-rose-dark transition-colors">去逛逛</a>
  </div>

  <template v-else>
    <!-- Two-column layout -->
    <div class="flex flex-col lg:flex-row gap-5 lg:gap-10 px-4 md:px-12 lg:px-20 pt-6 lg:pt-8 pb-12 lg:pb-16">
      <!-- Left: Cart Items -->
      <div class="flex-1 bg-forest-mid rounded-2xl overflow-hidden">
        <div
          v-for="item in items"
          :key="item.id"
          class="flex items-center gap-4 p-5 border-b border-forest-border last:border-0"
        >
          <img
            :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=100'"
            :alt="item.product.name"
            class="w-16 h-16 rounded-xl object-cover flex-shrink-0"
          />
          <div class="flex-1 min-w-0">
            <h3 class="text-text-primary text-[14px] truncate">{{ item.product.name }}</h3>
            <p class="text-apricot text-[13px] mt-0.5" style="font-family: 'Cormorant Garamond', serif;">NT$ {{ item.product.price.toLocaleString() }}</p>
          </div>

          <!-- Quantity -->
          <div class="flex items-center border border-forest-border rounded-full overflow-hidden">
            <button
              @click="updateQuantity(item.id, item.quantity - 1)"
              :disabled="item.quantity <= 1"
              class="w-8 h-8 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-forest-dark transition-colors disabled:opacity-30"
            >−</button>
            <span class="w-8 h-8 flex items-center justify-center text-[13px] text-text-primary border-x border-forest-border">{{ item.quantity }}</span>
            <button
              @click="updateQuantity(item.id, item.quantity + 1)"
              :disabled="item.quantity >= item.product.stock"
              class="w-8 h-8 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-forest-dark transition-colors disabled:opacity-30"
            >+</button>
          </div>

          <p class="text-text-primary text-[14px] w-24 text-right">
            NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
          </p>

          <button
            @click="confirmDelete(item.id)"
            class="text-text-muted hover:text-rose-primary transition-colors ml-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          </button>
        </div>
      </div>

      <!-- Right: Order Summary -->
      <div class="flex flex-col gap-5 w-full lg:w-[360px] lg:shrink-0">
        <div class="bg-forest-mid rounded-2xl p-7 flex flex-col gap-5">
          <h2 class="text-[28px] font-normal text-text-primary" style="font-family: 'Cormorant Garamond', serif;">訂單摘要</h2>

          <div class="flex flex-col gap-3">
            <div v-for="item in items" :key="'s'+item.id" class="flex justify-between text-[13px]">
              <span class="text-text-secondary">{{ item.product.name }} × {{ item.quantity }}</span>
              <span class="text-text-primary">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
            </div>
          </div>

          <div class="h-px bg-forest-border"></div>

          <div class="flex justify-between text-[13px]">
            <span class="text-text-secondary">商品小計</span>
            <span class="text-text-primary">NT$ {{ total.toLocaleString() }}</span>
          </div>
          <div class="flex justify-between text-[13px]">
            <span class="text-text-secondary">預估宅配運費（結帳可調整配送）</span>
            <span class="text-text-primary">{{ shipping.shippingFee === 0 ? '免運' : 'NT$ ' + shipping.shippingFee }}</span>
          </div>

          <div class="h-px bg-forest-border"></div>

          <div class="flex justify-between items-baseline">
            <span class="text-text-primary text-[15px] font-semibold">總計</span>
            <span class="text-apricot text-[28px]" style="font-family: 'Cormorant Garamond', serif;">
              NT$ {{ shipping.totalAmount.toLocaleString() }}
            </span>
          </div>

          <button
            @click="goCheckout"
            class="w-full bg-rose-primary text-text-primary py-4 rounded-full text-[14px] font-medium hover:bg-rose-dark transition-colors"
          >
            前往結帳 →
          </button>
        </div>

        <div class="flex items-center justify-center gap-2 text-text-muted text-[12px]">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          安全加密結帳
        </div>
      </div>
    </div>
  </template>

  <!-- Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/60" @click="confirmVisible = false"></div>
    <div class="relative bg-forest-mid rounded-2xl border border-forest-border w-full max-w-sm mx-4 p-6 text-center">
      <h3 class="text-[18px] font-normal text-text-primary mb-2" style="font-family: 'Cormorant Garamond', serif;">確認移除</h3>
      <p class="text-text-secondary text-[13px] mb-6">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex gap-3 justify-center">
        <button @click="confirmVisible = false" class="px-5 py-2 text-[13px] rounded-full border border-forest-border text-text-secondary hover:border-text-muted transition-colors">取消</button>
        <button @click="handleDelete" class="px-5 py-2 text-[13px] rounded-full bg-rose-primary text-text-primary hover:bg-rose-dark transition-colors">確認移除</button>
      </div>
    </div>
  </div>

</div>
