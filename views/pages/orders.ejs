<div id="app">
  <div class="flex flex-col md:flex-row gap-6 lg:gap-12 px-4 md:px-12 lg:px-20 py-8 lg:py-12">

    <!-- Left: Sidebar -->
    <div class="flex flex-col gap-1 w-full md:w-[220px] md:shrink-0">
      <h2 class="text-[24px] font-normal text-text-primary mb-3" style="font-family: 'Cormorant Garamond', serif;">我的帳號</h2>
      <div class="h-px bg-forest-border mb-2"></div>

      <a href="/orders" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-forest-mid text-text-primary text-[14px] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C17A5A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        <span>我的訂單</span>
      </a>
      <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-secondary text-[14px] hover:bg-forest-mid hover:text-text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5A7A64" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span>收藏清單</span>
      </a>
      <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-secondary text-[14px] hover:bg-forest-mid hover:text-text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5A7A64" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>地址管理</span>
      </a>
      <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-secondary text-[14px] hover:bg-forest-mid hover:text-text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5A7A64" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
        <span>帳號設定</span>
      </a>
    </div>

    <!-- Right: Orders -->
    <div class="flex-1 flex flex-col gap-5">
      <!-- Header + Filters -->
      <div class="flex items-center justify-between">
        <h1 class="text-[40px] font-normal text-text-primary" style="font-family: 'Cormorant Garamond', serif;">我的訂單</h1>
        <div class="flex items-center gap-2">
          <button
            @click="statusFilter = ''"
            class="px-5 py-2 rounded-full text-[13px] transition-colors"
            :class="statusFilter === '' ? 'bg-rose-primary text-text-primary' : 'bg-forest-mid text-text-secondary hover:text-text-primary'"
          >全部</button>
          <button
            @click="statusFilter = 'paid'"
            class="px-5 py-2 rounded-full text-[13px] transition-colors"
            :class="statusFilter === 'paid' ? 'bg-rose-primary text-text-primary' : 'bg-forest-mid text-text-secondary hover:text-text-primary'"
          >處理中</button>
          <button
            @click="statusFilter = 'delivered'"
            class="px-5 py-2 rounded-full text-[13px] transition-colors"
            :class="statusFilter === 'delivered' ? 'bg-rose-primary text-text-primary' : 'bg-forest-mid text-text-secondary hover:text-text-primary'"
          >已完成</button>
        </div>
      </div>

      <div v-if="loading" class="flex justify-center py-12">
        <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
      </div>

      <div v-else-if="filteredOrders.length === 0" class="text-center py-16">
        <p class="text-text-secondary mb-2">尚無訂單</p>
        <p class="text-text-muted text-[13px] mb-6">快去選購喜歡的花束吧！</p>
        <a href="/" class="inline-block bg-rose-primary text-text-primary px-8 py-3 rounded-full text-[13px] hover:bg-rose-dark transition-colors">去逛逛</a>
      </div>

      <div v-else class="flex flex-col gap-4">
        <a
          v-for="order in filteredOrders"
          :key="order.id"
          :href="'/orders/' + order.id"
          class="block bg-forest-mid rounded-2xl p-6 hover:ring-1 hover:ring-forest-border transition-all"
        >
          <div class="flex items-center justify-between mb-4">
            <div class="flex flex-col gap-1">
              <p class="text-text-primary text-[14px] font-medium">{{ order.order_no }}</p>
              <p class="text-text-muted text-[12px]">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</p>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-apricot text-[20px]" style="font-family: 'Cormorant Garamond', serif;">
                NT$ {{ order.total_amount.toLocaleString() }}
              </span>
              <span
                class="text-[12px] px-3 py-1 rounded-full font-medium"
                :class="statusMap[order.status]?.cls || 'bg-forest-border text-text-muted'"
              >
                {{ statusMap[order.status]?.label || order.status }}
              </span>
              <span class="text-text-muted">›</span>
            </div>
          </div>
          <div class="h-px bg-forest-border mb-4"></div>
          <p class="text-text-secondary text-[13px]">
            <span v-for="(item, i) in (order.items || [])" :key="i">
              {{ item.product_name }} × {{ item.quantity }}<span v-if="i < (order.items.length - 1)">、</span>
            </span>
          </p>
        </a>
      </div>
    </div>

  </div>
</div>
