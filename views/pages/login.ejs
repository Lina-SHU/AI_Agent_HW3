<div id="app" class="fixed inset-0 flex overflow-hidden">

  <!-- Left: Brand Panel — hidden on mobile -->
  <div class="hidden md:block md:w-[360px] lg:w-[700px] shrink-0 relative overflow-hidden" style="background: linear-gradient(135deg, #162D20 0%, #0A180F 100%);">
    <div class="absolute inset-0 flex flex-col justify-center px-10 lg:px-16 gap-6">
      <a href="/" class="text-[40px] lg:text-[52px] font-normal italic text-text-primary leading-none" style="font-family: 'Cormorant Garamond', serif;">
        花漾生活
      </a>
      <p class="text-text-secondary font-light leading-[1.5]" style="font-family: 'Cormorant Garamond', serif; font-size: clamp(18px, 2vw, 28px); font-weight: 300;">
        每一束花，都是生活中<br>最美的驚喜
      </p>
      <div style="width: 48px; height: 2px; background: #C17A5A;"></div>
      <p class="text-text-muted italic leading-[1.8] text-[13px] lg:text-[14px] max-w-[420px]">
        「精選當季花卉，專業花藝師手工打造，<br>為您的生活添加一抹自然的美好。」
      </p>
    </div>
    <div class="absolute bottom-0 left-10 lg:left-20 right-0" style="height: 280px;">
      <img
        src="https://images.unsplash.com/photo-1773425031578-84fa05feb29f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=80&w=800"
        alt="花束"
        style="width: 100%; height: 100%; object-fit: cover; border-radius: 20px 20px 0 0; opacity: 0.85;"
      />
    </div>
  </div>

  <!-- Right: Form Panel -->
  <div class="flex-1 flex items-center justify-center bg-forest-dark overflow-y-auto py-10">
    <div class="w-full max-w-[460px] px-6 md:px-14 lg:px-[60px]">

      <h1 class="text-text-primary italic font-normal" style="font-family: 'Cormorant Garamond', serif; font-size: 44px; margin-bottom: 8px;">歡迎回來</h1>
      <p class="text-text-secondary" style="font-size: 14px; margin-bottom: 32px;">登入您的帳號以繼續購物</p>

      <!-- Tabs -->
      <div class="bg-forest-mid rounded-full flex p-1" style="margin-bottom: 32px;">
        <button
          @click="activeTab = 'login'; errors = {}"
          class="flex-1 rounded-full py-2.5 text-[13px] font-medium transition-colors"
          :class="activeTab === 'login' ? 'bg-rose-primary text-text-primary' : 'text-text-secondary hover:text-text-primary'"
        >登入</button>
        <button
          @click="activeTab = 'register'; errors = {}"
          class="flex-1 rounded-full py-2.5 text-[13px] font-medium transition-colors"
          :class="activeTab === 'register' ? 'bg-rose-primary text-text-primary' : 'text-text-secondary hover:text-text-primary'"
        >註冊</button>
      </div>

      <!-- Login Form -->
      <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          <label class="text-text-secondary text-[13px]">Email</label>
          <input
            v-model="loginForm.email"
            type="email"
            placeholder="請輸入 Email"
            class="w-full bg-forest-mid border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary placeholder:text-forest-placeholder focus:outline-none focus:border-rose-primary transition-colors"
            :class="{ 'border-rose-primary': errors.email }"
          />
          <p v-if="errors.email" class="text-rose-primary text-[12px]">{{ errors.email }}</p>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-text-secondary text-[13px]">密碼</label>
          <input
            v-model="loginForm.password"
            type="password"
            placeholder="請輸入密碼"
            class="w-full bg-forest-mid border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary placeholder:text-forest-placeholder focus:outline-none focus:border-rose-primary transition-colors"
            :class="{ 'border-rose-primary': errors.password }"
          />
          <p v-if="errors.password" class="text-rose-primary text-[12px]">{{ errors.password }}</p>
        </div>

        <div class="flex justify-end">
          <a href="#" class="text-text-muted text-[12px] hover:text-text-secondary transition-colors">忘記密碼？</a>
        </div>

        <button
          type="submit"
          :disabled="submitting"
          class="w-full bg-rose-primary text-text-primary py-4 rounded-full text-[15px] font-medium hover:bg-rose-dark transition-colors disabled:opacity-40"
        >
          {{ submitting ? '登入中...' : '登入' }}
        </button>
      </form>

      <!-- Register Form -->
      <form v-else @submit.prevent="handleRegister" class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          <label class="text-text-secondary text-[13px]">姓名</label>
          <input
            v-model="registerForm.name"
            type="text"
            placeholder="請輸入姓名"
            class="w-full bg-forest-mid border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary placeholder:text-forest-placeholder focus:outline-none focus:border-rose-primary transition-colors"
            :class="{ 'border-rose-primary': errors.name }"
          />
          <p v-if="errors.name" class="text-rose-primary text-[12px]">{{ errors.name }}</p>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-text-secondary text-[13px]">Email</label>
          <input
            v-model="registerForm.email"
            type="email"
            placeholder="請輸入 Email"
            class="w-full bg-forest-mid border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary placeholder:text-forest-placeholder focus:outline-none focus:border-rose-primary transition-colors"
            :class="{ 'border-rose-primary': errors.email }"
          />
          <p v-if="errors.email" class="text-rose-primary text-[12px]">{{ errors.email }}</p>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-text-secondary text-[13px]">密碼</label>
          <input
            v-model="registerForm.password"
            type="password"
            placeholder="至少 6 個字元"
            class="w-full bg-forest-mid border border-forest-border rounded-xl px-4 py-3 text-[14px] text-text-primary placeholder:text-forest-placeholder focus:outline-none focus:border-rose-primary transition-colors"
            :class="{ 'border-rose-primary': errors.password }"
          />
          <p v-if="errors.password" class="text-rose-primary text-[12px]">{{ errors.password }}</p>
        </div>

        <button
          type="submit"
          :disabled="submitting"
          class="w-full bg-rose-primary text-text-primary py-4 rounded-full text-[15px] font-medium hover:bg-rose-dark transition-colors disabled:opacity-40"
        >
          {{ submitting ? '註冊中...' : '建立帳號' }}
        </button>
      </form>

      <!-- Divider -->
      <div class="flex items-center gap-3 my-6">
        <div class="flex-1 h-px bg-forest-border"></div>
        <span class="text-text-muted text-[12px]">或</span>
        <div class="flex-1 h-px bg-forest-border"></div>
      </div>

      <!-- Social Buttons -->
      <div class="flex flex-col gap-3">
        <button class="w-full flex items-center justify-center gap-3 bg-forest-mid border border-forest-border rounded-2xl py-3 text-[13px] text-text-secondary hover:border-text-muted transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          使用 Google 登入
        </button>
        <button class="w-full flex items-center justify-center gap-3 bg-forest-mid border border-forest-border rounded-2xl py-3 text-[13px] text-text-secondary hover:border-text-muted transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/></svg>
          使用 Apple 登入
        </button>
      </div>

    </div>
  </div>

</div>
