  <script src="/js/auth.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/notification.js"></script>
  <script src="/js/header-init.js"></script>
  <script src="/js/shipping.js"></script>
  
  <script src="/js/pages/cart.js"></script>
  
</body>
</html>
