<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>購物車 - 花漾生活</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Jost:wght@300;400;500;600&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="min-h-screen flex flex-col">
  <header class="sticky top-0 z-50 bg-forest-dark border-b border-forest-border">

  <!-- Desktop nav -->
  <div class="hidden md:flex items-center justify-between px-12 lg:px-20 h-[72px]">
    <a href="/" class="flex items-baseline gap-1 shrink-0">
      <span class="text-[28px] font-semibold italic text-text-primary leading-none" style="font-family: 'Cormorant Garamond', serif;">花漾</span>
      <span class="text-[28px] font-light text-sage leading-none" style="font-family: 'Cormorant Garamond', serif;">生活</span>
    </a>
    <nav class="flex items-center gap-10">
      <a href="/" class="text-sage hover:text-text-primary text-[13px] tracking-widest transition-colors">首頁</a>
      <a href="/#products" class="text-sage hover:text-text-primary text-[13px] tracking-widest transition-colors">商品</a>
      <a href="/" class="text-sage hover:text-text-primary text-[13px] tracking-widest transition-colors">關於我們</a>
    </nav>
    <div id="auth-nav" class="flex items-center gap-5 text-[13px] shrink-0">
      <a href="/login" class="text-sage hover:text-text-primary transition-colors">登入</a>
      <a href="/cart" class="flex items-center gap-1.5 bg-rose-primary text-text-primary px-4 py-1.5 rounded-full hover:bg-rose-dark transition-colors text-[13px] relative">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        購物車
        <span id="cart-badge" class="bg-forest-deep rounded-full w-5 h-5 flex items-center justify-center text-[11px] font-medium" style="display: none;"></span>
      </a>
    </div>
  </div>

  <!-- Mobile nav -->
  <div class="flex md:hidden items-center justify-between px-4 h-[60px]">
    <button id="hamburger-btn" aria-label="選單" class="w-10 h-10 flex flex-col justify-center gap-[5px] shrink-0" onclick="toggleMobileMenu()">
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-200"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-200"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-text-primary transition-all duration-200"></span>
    </button>
    <a href="/" class="flex items-baseline gap-1 absolute left-1/2 -translate-x-1/2">
      <span class="text-[24px] font-semibold italic text-text-primary leading-none" style="font-family: 'Cormorant Garamond', serif;">花漾</span>
      <span class="text-[24px] font-light text-sage leading-none" style="font-family: 'Cormorant Garamond', serif;">生活</span>
    </a>
    <a href="/cart" class="relative w-10 h-10 flex items-center justify-center text-text-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span id="cart-badge-mobile" class="absolute top-1 right-1 bg-rose-primary rounded-full w-4 h-4 flex items-center justify-center text-[10px] font-medium text-text-primary" style="display: none;"></span>
    </a>
  </div>

  <!-- Mobile drawer menu -->
  <div id="mobile-menu" class="fixed inset-0 z-[60] pointer-events-none">
    <div id="mobile-overlay" class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-300" onclick="toggleMobileMenu()"></div>
    <div id="mobile-drawer" class="absolute top-0 left-0 h-full w-72 bg-forest-dark border-r border-forest-border flex flex-col -translate-x-full transition-transform duration-300">
      <div class="flex items-center justify-between px-5 h-[60px] border-b border-forest-border shrink-0">
        <a href="/" class="flex items-baseline gap-1">
          <span class="text-[22px] font-semibold italic text-text-primary" style="font-family: 'Cormorant Garamond', serif;">花漾</span>
          <span class="text-[22px] font-light text-sage" style="font-family: 'Cormorant Garamond', serif;">生活</span>
        </a>
        <button onclick="toggleMobileMenu()" class="text-text-muted hover:text-text-primary p-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <nav class="flex flex-col py-4 px-3 gap-1 flex-1">
        <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-primary text-[15px] hover:bg-forest-mid transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          首頁
        </a>
        <a href="/#products" class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-secondary text-[15px] hover:bg-forest-mid hover:text-text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          商品
        </a>
        <a href="/cart" class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-secondary text-[15px] hover:bg-forest-mid hover:text-text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          購物車
        </a>
        <a href="/orders" class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-secondary text-[15px] hover:bg-forest-mid hover:text-text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          我的訂單
        </a>
      </nav>
      <div class="px-5 py-6 border-t border-forest-border">
        <div id="mobile-auth-nav">
          <a href="/login" class="block w-full text-center bg-rose-primary text-text-primary py-3 rounded-full text-[14px] font-medium hover:bg-rose-dark transition-colors">登入 / 註冊</a>
        </div>
      </div>
    </div>
  </div>

</header>

<script>
function toggleMobileMenu() {
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const drawer = document.getElementById('mobile-drawer');
  const isOpen = drawer.classList.contains('translate-x-0');
  if (isOpen) {
    drawer.classList.remove('translate-x-0');
    drawer.classList.add('-translate-x-full');
    overlay.classList.remove('opacity-100');
    overlay.classList.add('opacity-0');
    menu.classList.add('pointer-events-none');
  } else {
    menu.classList.remove('pointer-events-none');
    drawer.classList.remove('-translate-x-full');
    drawer.classList.add('translate-x-0');
    overlay.classList.remove('opacity-0');
    overlay.classList.add('opacity-100');
  }
}
</script>

  <main class="flex-1">
    <div id="app">

  <!-- Title Row -->
  <div class="flex items-baseline justify-between px-4 md:px-12 lg:px-20 pt-8 lg:pt-10 pb-0">
    <div class="flex items-baseline gap-3">
      <h1 class="text-[48px] font-normal italic text-text-primary" style="font-family: 'Cormorant Garamond', serif;">購物車</h1>
      <span v-if="items.length > 0" class="text-text-secondary text-[14px]">{{ items.length }} 件商品</span>
    </div>
    <a href="/" class="text-text-muted text-[13px] hover:text-text-secondary transition-colors">← 繼續購物</a>
  </div>

  <!-- Free Shipping Banner -->
  <div v-if="items.length > 0" class="mx-4 md:mx-12 lg:mx-20 mt-4">
    <div v-if="total < Shipping.FREE_SHIPPING_THRESHOLD" class="flex items-center justify-center gap-2 bg-forest-mid py-3 rounded-xl text-[13px] text-rose-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      再買 NT$ {{ (Shipping.FREE_SHIPPING_THRESHOLD - total).toLocaleString() }} 即可免宅配基本運費！
    </div>
    <div v-else class="flex items-center justify-center gap-2 bg-forest-mid py-3 rounded-xl text-[13px] text-sage">
      <span>✓</span> 已達免運門檻！
    </div>
  </div>

  <div v-if="loading" class="flex justify-center py-12 px-20">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="items.length === 0" class="text-center px-20 py-20">
    <p class="text-[64px] mb-4" style="font-family: 'Cormorant Garamond', serif; color: var(--color-forest-border);">∅</p>
    <p class="text-text-secondary mb-2">購物車是空的</p>
    <p class="text-text-muted text-[13px] mb-6">快去挑選喜歡的花束吧！</p>
    <a href="/" class="inline-block bg-rose-primary text-text-primary px-8 py-3 rounded-full text-[13px] hover:bg-rose-dark transition-colors">去逛逛</a>
  </div>

  <template v-else>
    <!-- Two-column layout -->
    <div class="flex flex-col lg:flex-row gap-5 lg:gap-10 px-4 md:px-12 lg:px-20 pt-6 lg:pt-8 pb-12 lg:pb-16">
      <!-- Left: Cart Items -->
      <div class="flex-1 bg-forest-mid rounded-2xl overflow-hidden">
        <div
          v-for="item in items"
          :key="item.id"
          class="flex items-center gap-4 p-5 border-b border-forest-border last:border-0"
        >
          <img
            :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=100'"
            :alt="item.product.name"
            class="w-16 h-16 rounded-xl object-cover flex-shrink-0"
          />
          <div class="flex-1 min-w-0">
            <h3 class="text-text-primary text-[14px] truncate">{{ item.product.name }}</h3>
            <p class="text-apricot text-[13px] mt-0.5" style="font-family: 'Cormorant Garamond', serif;">NT$ {{ item.product.price.toLocaleString() }}</p>
          </div>

          <!-- Quantity -->
          <div class="flex items-center border border-forest-border rounded-full overflow-hidden">
            <button
              @click="updateQuantity(item.id, item.quantity - 1)"
              :disabled="item.quantity <= 1"
              class="w-8 h-8 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-forest-dark transition-colors disabled:opacity-30"
            >−</button>
            <span class="w-8 h-8 flex items-center justify-center text-[13px] text-text-primary border-x border-forest-border">{{ item.quantity }}</span>
            <button
              @click="updateQuantity(item.id, item.quantity + 1)"
              :disabled="item.quantity >= item.product.stock"
              class="w-8 h-8 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-forest-dark transition-colors disabled:opacity-30"
            >+</button>
          </div>

          <p class="text-text-primary text-[14px] w-24 text-right">
            NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
          </p>

          <button
            @click="confirmDelete(item.id)"
            class="text-text-muted hover:text-rose-primary transition-colors ml-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          </button>
        </div>
      </div>

      <!-- Right: Order Summary -->
      <div class="flex flex-col gap-5 w-full lg:w-[360px] lg:shrink-0">
        <div class="bg-forest-mid rounded-2xl p-7 flex flex-col gap-5">
          <h2 class="text-[28px] font-normal text-text-primary" style="font-family: 'Cormorant Garamond', serif;">訂單摘要</h2>

          <div class="flex flex-col gap-3">
            <div v-for="item in items" :key="'s'+item.id" class="flex justify-between text-[13px]">
              <span class="text-text-secondary">{{ item.product.name }} × {{ item.quantity }}</span>
              <span class="text-text-primary">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
            </div>
          </div>

          <div class="h-px bg-forest-border"></div>

          <div class="flex justify-between text-[13px]">
            <span class="text-text-secondary">商品小計</span>
            <span class="text-text-primary">NT$ {{ total.toLocaleString() }}</span>
          </div>
          <div class="flex justify-between text-[13px]">
            <span class="text-text-secondary">預估宅配運費（結帳可調整配送）</span>
            <span class="text-text-primary">{{ shipping.shippingFee === 0 ? '免運' : 'NT$ ' + shipping.shippingFee }}</span>
          </div>

          <div class="h-px bg-forest-border"></div>

          <div class="flex justify-between items-baseline">
            <span class="text-text-primary text-[15px] font-semibold">總計</span>
            <span class="text-apricot text-[28px]" style="font-family: 'Cormorant Garamond', serif;">
              NT$ {{ shipping.totalAmount.toLocaleString() }}
            </span>
          </div>

          <button
            @click="goCheckout"
            class="w-full bg-rose-primary text-text-primary py-4 rounded-full text-[14px] font-medium hover:bg-rose-dark transition-colors"
          >
            前往結帳 →
          </button>
        </div>

        <div class="flex items-center justify-center gap-2 text-text-muted text-[12px]">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          安全加密結帳
        </div>
      </div>
    </div>
  </template>

  <!-- Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/60" @click="confirmVisible = false"></div>
    <div class="relative bg-forest-mid rounded-2xl border border-forest-border w-full max-w-sm mx-4 p-6 text-center">
      <h3 class="text-[18px] font-normal text-text-primary mb-2" style="font-family: 'Cormorant Garamond', serif;">確認移除</h3>
      <p class="text-text-secondary text-[13px] mb-6">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex gap-3 justify-center">
        <button @click="confirmVisible = false" class="px-5 py-2 text-[13px] rounded-full border border-forest-border text-text-secondary hover:border-text-muted transition-colors">取消</button>
        <button @click="handleDelete" class="px-5 py-2 text-[13px] rounded-full bg-rose-primary text-text-primary hover:bg-rose-dark transition-colors">確認移除</button>
      </div>
    </div>
  </div>

</div>

  </main>
  <footer class="bg-forest-deep border-t border-forest-border">
  <div class="flex flex-col md:flex-row items-center justify-between gap-4 px-4 md:px-12 lg:px-20 py-6 md:h-[100px] md:py-0">
    <span class="text-2xl italic font-normal text-text-primary" style="font-family: 'Cormorant Garamond', serif;">花漾生活</span>
    <p class="text-text-muted text-[12px]">© 2026 花漾生活. All rights reserved.</p>
    <div class="flex items-center gap-3">
      <a href="#" aria-label="Instagram" class="w-9 h-9 flex items-center justify-center rounded-full bg-forest-dark border border-forest-border text-text-muted hover:text-text-primary hover:border-text-muted transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <a href="#" aria-label="Facebook" class="w-9 h-9 flex items-center justify-center rounded-full bg-forest-dark border border-forest-border text-text-muted hover:text-text-primary hover:border-text-muted transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href="#" aria-label="Twitter" class="w-9 h-9 flex items-center justify-center rounded-full bg-forest-dark border border-forest-border text-text-muted hover:text-text-primary hover:border-text-muted transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
      </a>
    </div>
  </div>
</footer>

  <div id="notification-toast" class="fixed top-20 right-4 z-[100] px-5 py-3 rounded-xl shadow-lg text-sm" style="display: none; opacity: 0;"></div>


