    <div id="mobile-drawer" class="absolute top-0 left-0 h-full w-72 bg-forest-dark border-r border-forest-border flex flex-col -translate-x-full transition-transform duration-300">
      <div class="flex items-center justify-between px-5 h-[60px] border-b border-forest-border shrink-0">
        <a href="/" class="flex items-baseline gap-1">
          <span class="text-[22px] font-semibold italic text-text-primary" style="font-family: 'Cormorant Garamond', serif;">花漾</span>
          <span class="text-[22px] font-light text-sage" style="font-family: 'Cormorant Garamond', serif;">生活</span>
        </a>
